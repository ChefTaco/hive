{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../services/hive-router/node_modules/@types"
    ]
  },
  "include": [
    "model-e2e.ts",
    "model-e2e.test.ts",
    "deploy-npm.ts",
    "deploy-npm.test.ts"
  ]
}
