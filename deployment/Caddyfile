{
	admin off
	https_port 8443
	auto_https disable_redirects
}

# Upstream connections stay idle for at most 2 seconds. The products are Node servers, which close
# an idle keep-alive connection after 5 seconds; a connection kept longer can be reused at the
# instant the backend closes it, and a request that is not retried (a POST) then fails.
(verified_backend) {
	flush_interval -1
	transport http {
		tls
		tls_server_name {args[0]}
		tls_trust_pool file /config/backend-ca.pem
		keepalive 2s
	}
}

# Plain HTTP upstreams on the private network, with the same idle limit.
(plain_backend) {
	transport http {
		keepalive 2s
	}
}

# Product session cookies stay within their owning API, including responses.
# The second argument lists the other products' published credential cookies.
# Authorization headers are always supplied by the caller, never by ingress.
(product_backend) {
	import verified_backend {args[0]}
	header_up Cookie "(^|;)[ \t]*({args[1]})=[^;]*" "$1"
	header_down Set-Cookie "^[ \t]*({args[1]})=.*$" ""
}

(stateless_backend) {
	import verified_backend {args[0]}
	header_up -Cookie
	header_down -Set-Cookie
}

# Magnus's browser routes. A Magnus in this installation is verified against the suite authority,
# as every other product is. An external Magnus, on another host and managed separately, has a
# publicly trusted certificate: setup sets MAGNUS_TRUST_FILE to this image's system trust store,
# and its host name (MAGNUS_TLS_NAME) is verified all the same. See deployment/FULL.md.
(magnus_verified_backend) {
	flush_interval -1
	transport http {
		tls
		tls_server_name {args[0]}
		tls_trust_pool file {$MAGNUS_TRUST_FILE:/config/backend-ca.pem}
		keepalive 2s
	}
	header_up -Cookie
	header_down -Set-Cookie
}

(magnus_backend) {
	import magnus_verified_backend {args[0]}
	# Default deny: the API reads only these. x-api-secret grants system ADMIN and
	# x-node-token an agent's access, so a browser must never be able to send them.
	# x-acting-subject names the person a linked service acts for; only that service,
	# on the private network, may send it, never a browser.
	header_up -*
	header_up -X-Api-Secret
	header_up -X-Node-Token
	header_up -X-Acting-Subject
	header_up Authorization {http.request.header.Authorization}
	header_up Content-Type {http.request.header.Content-Type}
	header_up Accept {http.request.header.Accept}
	# A reconnecting event stream resumes from the last event it received.
	header_up Last-Event-ID {http.request.header.Last-Event-ID}
	header_up X-Idempotency-Key {http.request.header.X-Idempotency-Key}
	header_up X-Trace-Id {http.request.header.X-Trace-Id}
	header_up X-Forwarded-For {client_ip}
}

# The published port for Magnus host agents, on a fresh installation whose console.nativeListeners
# names magnus. It goes around the browser allowlist below, so it has its own: only the routes
# the Magnus agent and its Hermes sync call, with their own credentials (x-node-token,
# x-log-token, x-hermes-registry-token). No Authorization, cookie, x-api-secret, gateway token
# or other header passes, so no operator, browser or system request can be served here, and
# X-Forwarded-For is the client's address, never one the client sent. Everything else is 404.
(magnus_agent_listener) {
	@magnus_agent_unsafe_path expression <<CEL
		{http.request.orig_uri}.matches(r"(?i)^[^?]*(//|/\.\.?(/|\?|$)|\\|%(2f|5c|2e|25|[01][0-9a-f]|7f))")
		CEL
	handle @magnus_agent_unsafe_path {
		respond "API unavailable" 404
	}
	@magnus_agent expression <<CEL
		({method} == "GET" && (
			{path} == "/"
			|| {path} == "/api/v1/hermes-registry/manifest"
			|| {path} == "/api/v1/hermes-registry/profiles"
			|| {path} == "/api/v1/hermes-registry/policy"
			|| {path}.matches("^/api/v1/hermes-registry/artifacts/[^/]+/[^/]+/[^/]+$")
		))
		|| ({method} == "POST" && (
			{path} == "/api/v1/heartbeat"
			|| {path} == "/api/v1/logs/ingest"
			|| {path} == "/api/v1/resource-leases/claim"
			|| {path} == "/api/v1/resource-leases/recovery-claim"
			|| {path} == "/api/v1/resource-leases/legacy-admission"
			|| {path} == "/api/v1/resource-leases/enrollment/node-status"
			|| {path} == "/api/v1/resource-leases/enrollment/scheduler-status"
			|| {path} == "/api/v1/resource-leases/enrollment/terminal-claim"
			|| {path} == "/api/v1/resource-leases/enrollment/terminal-receipt"
			|| {path}.matches("^/api/v1/resource-leases/enrollment/work/[^/]+/node-receipt$")
			|| {path} == "/api/v1/cron/managed-occurrences/admit"
			|| {path} == "/api/v1/cron/managed-occurrences/settle"
			|| {path} == "/api/v1/hermes-registry/core/slot"
			|| {path} == "/api/v1/hermes-registry/core/receipts"
			|| {path} == "/api/v1/hermes-registry/tool-surface"
			|| {path} == "/api/v1/hermes-registry/policy/receipts"
			|| {path} == "/api/v1/hermes-registry/capture"
			|| {path} == "/api/v1/hermes-registry/receipts"
			|| {path} == "/api/v1/hermes-registry/inventory"
		))
		CEL
	handle @magnus_agent {
		reverse_proxy {$MAGNUS_ENDPOINT:https://unconfigured.invalid} {
			import stateless_backend {$MAGNUS_TLS_NAME:unconfigured.invalid}
			header_up -*
			header_up Content-Type {http.request.header.Content-Type}
			header_up Accept {http.request.header.Accept}
			header_up X-Node-Token {http.request.header.X-Node-Token}
			header_up X-Log-Token {http.request.header.X-Log-Token}
			header_up X-Hermes-Registry-Token {http.request.header.X-Hermes-Registry-Token}
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		respond "API unavailable" 404
	}
	handle_errors {
		respond "Service unavailable" 503
	}
}

# The Magnus fleet gateway's browser routes. Default deny, as for magnus_backend, except
# that the gateway also needs Origin and Sec-Fetch-Site: without them its cross-origin
# check is silently off. A header set here is sent even when empty, and the gateway
# refuses an empty one, so each caller passes only the ones this request really has.
(magnus_terminal_upstream) {
	reverse_proxy {$MAGNUS_GATEWAY_ENDPOINT:https://unconfigured.invalid} {
		import stateless_backend {$MAGNUS_GATEWAY_TLS_NAME:unconfigured.invalid}
		header_up -*
		header_up Authorization {http.request.header.Authorization}
		header_up Content-Type {http.request.header.Content-Type}
		header_up Accept {http.request.header.Accept}
		header_up X-Forwarded-For {client_ip}
		{block}
	}
}

# Hive Registry: this installation's install catalog, not the HiveSkills skills
# registry. Default deny: GET only, an explicit route list, no cookies, and only a
# well-formed bearer credential. The registry decides what that credential may see.
(hive_registry_backend) {
	import plain_backend
	header_up -*
	header_up Authorization {http.request.header.Authorization}
	header_up Accept {http.request.header.Accept}
	header_up X-Forwarded-For {client_ip}
	header_down -Set-Cookie
}

{$HIVE_CONSOLE_HOST} {
	tls /config/console.crt /config/console.key
	handle /_hive/ready {
		respond "ready" 200
	}
	# Present only on an installation migrated from native services (hive.sh migrate-native):
	# the paths its clients already use on this port. Imported first, so these win.
	import /config/native-routes*.caddy
	@magnus_ready {
		method GET
		path /api/magnus/health/ready
	}
	@magnus_docs {
		method GET
		path /api/magnus/docs/openapi.json
	}
	@registry_ready {
		method GET
		path /api/registry/health/ready
	}
	handle @registry_ready {
		rewrite * /health/ready
		reverse_proxy http://hive-registry:8095 {
			import plain_backend
			header_up -*
			header_up Accept {http.request.header.Accept}
			header_down -Set-Cookie
		}
	}
	handle /api/emberpath/health/ready {
		rewrite * /health/ready
		reverse_proxy {$EMBERPATH_ENDPOINT:https://unconfigured.invalid} {
			import stateless_backend {$EMBERPATH_TLS_NAME:unconfigured.invalid}
		}
	}
	handle /api/cindertrace/health/ready {
		rewrite * /ready
		reverse_proxy {$CINDERTRACE_ENDPOINT:https://unconfigured.invalid} {
			import stateless_backend {$CINDERTRACE_TLS_NAME:unconfigured.invalid}
		}
	}
	handle_path /api/emberpath/* {
		rewrite * /api{uri}
		reverse_proxy {$EMBERPATH_ENDPOINT:https://unconfigured.invalid} {
			import product_backend {$EMBERPATH_TLS_NAME:unconfigured.invalid} "__Host-oathweave_sso|iam_refresh|hivemem_dash|hive_skills_session|cindertrace_session|MMSID|MMUSERID|MMCSRF"
		}
	}
	handle_path /api/oathweave/* {
		rewrite * /api/v1{uri}
		reverse_proxy {$OATHWEAVE_ENDPOINT:https://unconfigured.invalid} {
			import product_backend {$OATHWEAVE_TLS_NAME:unconfigured.invalid} "hive_router_admin|hivemem_dash|hive_skills_session|cindertrace_session|MMSID|MMUSERID|MMCSRF"
		}
	}
	handle_path /api/hivemem/* {
		rewrite * /v1{uri}
		reverse_proxy {$HIVEMEM_ENDPOINT:https://unconfigured.invalid} {
			import product_backend {$HIVEMEM_TLS_NAME:unconfigured.invalid} "__Host-oathweave_sso|iam_refresh|hive_router_admin|hive_skills_session|cindertrace_session|MMSID|MMUSERID|MMCSRF"
		}
	}
	handle_path /api/hiveskills/* {
		reverse_proxy {$HIVESKILLS_ENDPOINT:https://unconfigured.invalid} {
			import product_backend {$HIVESKILLS_TLS_NAME:unconfigured.invalid} "__Host-oathweave_sso|iam_refresh|hive_router_admin|hivemem_dash|cindertrace_session|MMSID|MMUSERID|MMCSRF"
		}
	}
	handle_path /api/cindertrace/* {
		rewrite * /api/v1{uri}
		reverse_proxy {$CINDERTRACE_ENDPOINT:https://unconfigured.invalid} {
			import product_backend {$CINDERTRACE_TLS_NAME:unconfigured.invalid} "__Host-oathweave_sso|iam_refresh|hive_router_admin|hivemem_dash|hive_skills_session|MMSID|MMUSERID|MMCSRF"
		}
	}
	handle_path /api/chattermost/* {
		reverse_proxy {$CHATTERMOST_ENDPOINT:https://unconfigured.invalid} {
			import product_backend {$CHATTERMOST_TLS_NAME:unconfigured.invalid} "__Host-oathweave_sso|iam_refresh|hive_router_admin|hivemem_dash|hive_skills_session|cindertrace_session"
		}
	}
	# Magnus is reached only by the browser console, with a bearer token. The
	# routes below are the browser-facing rows of Magnus's docs/console-api.md and
	# nothing else: machine-only, excluded and retired routes answer 404 here.
	handle @magnus_ready {
		rewrite * /api/v1/health
		reverse_proxy {$MAGNUS_ENDPOINT:https://unconfigured.invalid} {
			import magnus_backend {$MAGNUS_TLS_NAME:unconfigured.invalid}
		}
	}
	# The one browser route outside /api/v1. It is public and has one exact target.
	handle @magnus_docs {
		rewrite * /api/docs/openapi.json
		reverse_proxy {$MAGNUS_ENDPOINT:https://unconfigured.invalid} {
			import magnus_backend {$MAGNUS_TLS_NAME:unconfigured.invalid}
		}
	}
	handle_path /api/magnus/* {
		rewrite * /api/v1{uri}
		# Patterns match decoded paths, so refuse any request whose raw path could
		# read differently here and upstream.
		@magnus_unsafe_path expression <<CEL
			!{http.request.orig_uri}.matches(r"^/api/magnus/")
			|| {http.request.orig_uri}.matches(r"(?i)^[^?]*(//|/\.\.?(/|\?|$)|\\|%(2f|5c|2e|25|[01][0-9a-f]|7f))")
			CEL
		handle @magnus_unsafe_path {
			respond "API unavailable" 404
		}
		# The browser terminal is the optional fleet gateway, not Magnus: these exact routes
		# and methods reach the gateway's /terminal/*, and nothing else on it has a route, so
		# /internal stays reachable only by the Magnus API. With no gateway selected the
		# routes answer 404 like any other, and POST /api/v1/terminal/ticket stays retired.
		@magnus_terminal expression <<CEL
			"{$MAGNUS_GATEWAY_ENDPOINT:}" != "" && (
				({method} == "POST" && {path}.matches("^/api/v1/terminal/(open|input|resize|renew|close)$"))
				|| ({method} == "GET" && {path}.matches("^/api/v1/terminal/(stream|status)$"))
			)
			CEL
		handle @magnus_terminal {
			@magnus_terminal_not_bearer {
				header Authorization *
				not header_regexp Authorization "^Bearer [^ ,]+$"
			}
			handle @magnus_terminal_not_bearer {
				respond "Bearer token required" 401
			}
			uri strip_prefix /api/v1
			@terminal_origin_and_site {
				header Origin *
				header Sec-Fetch-Site *
			}
			handle @terminal_origin_and_site {
				import magnus_terminal_upstream {
					header_up Origin {http.request.header.Origin}
					header_up Sec-Fetch-Site {http.request.header.Sec-Fetch-Site}
				}
			}
			@terminal_origin_only {
				header Origin *
				not header Sec-Fetch-Site *
			}
			handle @terminal_origin_only {
				import magnus_terminal_upstream {
					header_up Origin {http.request.header.Origin}
				}
			}
			# A browser sends no Origin on a same-origin GET.
			@terminal_site_only {
				not header Origin *
				header Sec-Fetch-Site *
			}
			handle @terminal_site_only {
				import magnus_terminal_upstream {
					header_up Sec-Fetch-Site {http.request.header.Sec-Fetch-Site}
				}
			}
			handle {
				import magnus_terminal_upstream
			}
		}
		# A route parameter also matches a literal segment. These non-browser routes
		# are shadowed by a broader browser pattern, so they are refused first.
		@magnus_explicit_deny {
			method GET
			path /api/v1/agents/upgrade/runs/latest
			path /api/v1/nodes/compare /api/v1/nodes/scan-users /api/v1/nodes/tags
			path /api/v1/ardent/installations/*/profiles/*/context-adoptions/*
			path /api/v1/ardent/installations/*/profiles/*/context-release
		}
		handle @magnus_explicit_deny {
			respond "API unavailable" 404
		}
		@magnus_browser expression <<CEL
			({method} == "GET" && (
				{path} == "/api/v1/agents/upgrade/eligibility"
				|| {path}.matches("^/api/v1/agents/upgrade/runs/[^/]+$")
				|| {path} == "/api/v1/anomalies"
				|| {path}.matches("^/api/v1/anomalies/event/[^/]+/correlation$")
				|| {path} == "/api/v1/anomalies/summary"
				|| {path}.matches("^/api/v1/ardent/agents/operations/[^/]+$")
				|| {path}.matches("^/api/v1/ardent/agents/operations/[^/]+/stream$")
				|| {path} == "/api/v1/ardent/installations"
				|| {path}.matches("^/api/v1/ardent/installations/[^/]+$")
				|| {path}.matches("^/api/v1/ardent/installations/[^/]+/profiles/[^/]+/.+$")
				|| {path}.matches("^/api/v1/ardent/installations/[^/]+/profiles/[^/]+/artifacts/[^/]+$")
				|| {path} == "/api/v1/ardent/profiles"
				|| {path} == "/api/v1/assistant/conversations"
				|| {path} == "/api/v1/assistant/insights"
				|| {path} == "/api/v1/assistant/insights/pins"
				|| {path}.matches("^/api/v1/assistant/shares/[^/]+$")
				|| {path} == "/api/v1/audit"
				|| {path} == "/api/v1/audit/days"
				|| {path} == "/api/v1/codex/installations"
				|| {path}.matches("^/api/v1/codex/installations/[^/]+$")
				|| {path}.matches("^/api/v1/codex/installations/[^/]+/device-auth/[^/]+$")
				|| {path} == "/api/v1/commands"
				|| {path}.matches("^/api/v1/commands/[^/]+$")
				|| {path}.matches("^/api/v1/commands/[^/]+/result$")
				|| {path} == "/api/v1/console/session"
				|| {path} == "/api/v1/cron"
				|| {path}.matches("^/api/v1/cron/[^/]+$")
				|| {path} == "/api/v1/dependencies"
				|| {path} == "/api/v1/events/stream"
				|| {path} == "/api/v1/files/read"
				|| {path} == "/api/v1/health"
				|| {path}.matches("^/api/v1/health/[^/]+/forecast$")
				|| {path} == "/api/v1/hermes/installations"
				|| {path}.matches("^/api/v1/hermes/installations/[^/]+/profiles$")
				|| {path} == "/api/v1/hermes/profiles"
				|| {path} == "/api/v1/library/categories"
