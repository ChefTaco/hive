			))
			|| ({method} == "PUT" && (
				{path} == "/api/v1/notifications/preferences"
			))
			|| ({method} == "PATCH" && (
				{path}.matches("^/api/v1/cron/[^/]+$")
				|| {path}.matches("^/api/v1/library/categories/[^/]+$")
				|| {path}.matches("^/api/v1/library/files/[^/]+$")
				|| {path}.matches("^/api/v1/nodes/[^/]+$")
				|| {path}.matches("^/api/v1/remediation/rules/[^/]+$")
				|| {path}.matches("^/api/v1/roles/[^/]+$")
				|| {path}.matches("^/api/v1/webhooks/[^/]+$")
			))
			|| ({method} == "DELETE" && (
				{path}.matches("^/api/v1/assistant/insights/pins/[^/]+$")
				|| {path}.matches("^/api/v1/cron/[^/]+$")
				|| {path}.matches("^/api/v1/library/categories/[^/]+$")
				|| {path}.matches("^/api/v1/library/files/[^/]+$")
				|| {path}.matches("^/api/v1/nodes/[^/]+$")
				|| {path}.matches("^/api/v1/remediation/rules/[^/]+$")
				|| {path}.matches("^/api/v1/roles/[^/]+$")
				|| {path}.matches("^/api/v1/webhooks/[^/]+$")
			))
			CEL
		handle @magnus_browser {
			@magnus_not_bearer {
				header Authorization *
				not header_regexp Authorization "^Bearer [^ ,]+$"
			}
			respond @magnus_not_bearer "Bearer token required" 401
			reverse_proxy {$MAGNUS_ENDPOINT:https://unconfigured.invalid} {
				import magnus_backend {$MAGNUS_TLS_NAME:unconfigured.invalid}
			}
		}
		handle {
			respond "API unavailable" 404
		}
	}
	handle_path /api/registry/* {
		# Patterns match decoded paths, so refuse any request whose raw path could
		# read differently here and upstream.
		@registry_unsafe_path expression <<CEL
			!{http.request.orig_uri}.matches(r"^/api/registry/")
			|| {http.request.orig_uri}.matches(r"(?i)^[^?]*(//|/\.\.?(/|\?|$)|\\|%(2f|5c|2e|25|[01][0-9a-f]|7f))")
			CEL
		handle @registry_unsafe_path {
			respond "API unavailable" 404
		}
		@registry_not_get not method GET
		handle @registry_not_get {
			header Allow GET
			respond "Method not allowed" 405
		}
		@registry_read path_regexp ^/v1/(installation|products(/[a-z][a-z0-9-]{0,47}(/connection)?)?)$
		handle @registry_read {
			@registry_not_bearer {
				header Authorization *
				not header_regexp Authorization "^Bearer [^ ,]+$"
			}
			respond @registry_not_bearer "Bearer token required" 401
			reverse_proxy http://hive-registry:8095 {
				import hive_registry_backend
			}
		}
		handle {
			respond "API unavailable" 404
		}
	}
	# Ardent Project Studio serves its own /api/ardentstudio prefix over plain HTTP on this
	# host's private network, present only when it is installed (ARDENTSTUDIO_ENDPOINT); without
	# it the path answers 404 like any unknown API. It authenticates with bearer tokens and sets
	# no cookie, so every cookie is removed both ways. Its project streams are SSE: unbuffered.
	@ardentstudio {
		path /api/ardentstudio/*
		expression `"{$ARDENTSTUDIO_ENDPOINT:}" != ""`
	}
	handle @ardentstudio {
		reverse_proxy {$ARDENTSTUDIO_ENDPOINT:http://unconfigured.invalid} {
			import plain_backend
			flush_interval -1
			header_up -Cookie
			header_down -Set-Cookie
		}
	}
	# Emberfold has an optional co-located HTTP listener. HTTPS terminates here;
	# its own bearer token remains mandatory and is supplied by the native client.
	handle_path /api/emberfold/* {
		reverse_proxy http://emberfold:8096 {
			import plain_backend
			header_up -Cookie
			header_down -Set-Cookie
		}
	}
	# Preserve explicit native model, memory, chat and signed security paths.
	handle /v1/* {
		reverse_proxy {$EMBERPATH_API_ENDPOINT:https://unconfigured.invalid} {
			import stateless_backend {$EMBERPATH_API_TLS_NAME:unconfigured.invalid}
		}
	}
	handle_path /memory/* {
		reverse_proxy {$HIVEMEM_ENDPOINT:https://unconfigured.invalid} {
			import product_backend {$HIVEMEM_TLS_NAME:unconfigured.invalid} "__Host-oathweave_sso|iam_refresh|hive_router_admin|hive_skills_session|cindertrace_session|MMSID|MMUSERID|MMCSRF"
		}
	}
	handle /api/v4/* {
		reverse_proxy {$CHATTERMOST_ENDPOINT:https://unconfigured.invalid} {
			import product_backend {$CHATTERMOST_TLS_NAME:unconfigured.invalid} "__Host-oathweave_sso|iam_refresh|hive_router_admin|hivemem_dash|hive_skills_session|cindertrace_session"
		}
	}
	handle /api/v1/security-fusion/* {
		reverse_proxy {$CINDERTRACE_ENDPOINT:https://unconfigured.invalid} {
			import product_backend {$CINDERTRACE_TLS_NAME:unconfigured.invalid} "__Host-oathweave_sso|iam_refresh|hive_router_admin|hivemem_dash|hive_skills_session|MMSID|MMUSERID|MMCSRF"
		}
	}
	@unknown_api path /api/* /api-docs/*
	handle @unknown_api {
		respond "API unavailable" 404
	}
	handle {
		reverse_proxy http://hivexui:8080 {
			import plain_backend
			header_up -Cookie
			header_up -Authorization
			header_down -Set-Cookie
		}
	}
	handle_errors {
		respond "Service unavailable" 503
	}
}

# Present only on a migrated installation: the native listeners its clients already use. On a
# fresh installation with a Magnus agent port, native-listeners-magnus-agents.caddy serves it.
import /config/native-listeners*.caddy

# Container-local readiness only; never published on the host.
http://127.0.0.1:8081 {
	respond /ready "ready" 200
}
