          "browserPrefix": "/api/registry",
          "consolePath": null,
          "nativeApis": {},
          "internalEndpoints": {
            "api": "http://hive-registry:8095"
          }
        },
        "capabilities": {
          "inventory.v1": {
            "path": "/v1/inventory"
          }
        }
      },
      "service": {
        "user": "1000:1000",
        "networks": [
