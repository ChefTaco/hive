      "image": "ghcr.io/cheftaco/hive-postgres@sha256:0224a713e2942d7ec0f826843b733cccbeb13a3283c8f38c27c3f020c0a13cd8",
      "kind": "datastore",
      "storageFormat": "magnus-postgres-17-runtime2",
      "service": {
        "user": "1000:1000",
        "tmpfs": [
          "/var/run/postgresql"
        ],
        "environment": {
          "PGDATA": "/data/pgdata",
          "POSTGRES_DB": "magnus",
          "POSTGRES_USER": "magnus",
          "POSTGRES_PASSWORD_FILE": "/config/password",
          "POSTGRES_INITDB_ARGS": "--data-checksums"
        },
        "networks": [
          "magnus-data"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "pg_isready",
            "-h",
            "127.0.0.1",
            "-U",
            "magnus",
            "-d",
            "magnus"
          ],
          "interval": "2s",
          "timeout": "5s",
          "retries": 40,
          "start_period": "5s"
