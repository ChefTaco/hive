        "documentation": "https://github.com/ChefTaco/hive/blob/HEAD/docs/hive-registry-api.md",
        "license": "https://github.com/ChefTaco/hive/blob/HEAD/LICENSE",
        "licenseSpdx": "Apache-2.0",
        "consoleSection": null,
        "required": true,
        "dependencies": [],
        "connection": {
          "browserPrefix": "/api/registry",
          "consolePath": null,
          "nativeApis": {},
          "internalEndpoints": {
            "api": "http://hive-registry:8095"
          }
        }
      },
      "service": {
        "user": "1000:1000",
        "networks": [
          "default"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "node",
            "/app/dist/cli.js",
            "health"
          ],
          "interval": "2s",
          "timeout": "4s",
          "retries": 30,
          "start_period": "2s"
        }
      }
    },
