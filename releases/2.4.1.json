      "kind": "datastore",
      "storageFormat": "magnus-postgres-17",
      "service": {
        "user": "1000:1000",
        "tmpfs": [
          "/var/run/postgresql"
        ],
        "environment": {
          "PGDATA": "/data/pgdata",
          "POSTGRES_DB": "magnus",
          "POSTGRES_USER": "magnus",
          "POSTGRES_PASSWORD_FILE": "/config/password",
          "POSTGRES_INITDB_ARGS": "--data-checksums"
        },
        "networks": [
          "magnus-data"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "pg_isready",
            "-h",
            "127.0.0.1",
            "-U",
            "magnus",
            "-d",
            "magnus"
          ],
