        "consoleSection": null,
        "required": true,
        "dependencies": [],
        "connection": {
          "browserPrefix": "/api/registry",
          "consolePath": null,
          "nativeApis": {},
          "internalEndpoints": {
            "api": "http://hive-registry:8095"
          }
        }
      },
      "service": {
        "user": "1000:1000",
        "networks": [
          "default"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "node",
            "/app/dist/cli.js",
