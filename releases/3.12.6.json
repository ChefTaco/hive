    "hivemem-qdrant": {
      "image": "ghcr.io/cheftaco/hive-qdrant@sha256:78466d7bd03ceffb6baf57fdf2fffc4ea45f6b08b771d9a3425ace629741b48d",
      "kind": "datastore",
      "storageFormat": "qdrant-v1.18.1",
      "service": {
        "user": "1000:1000",
        "working_dir": "/data",
        "entrypoint": [
          "/qdrant/qdrant"
        ],
        "command": [
          "--config-path",
          "/config/qdrant.yaml"
        ],
        "networks": [
          "memory-data"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "bash",
            "-ec",
            "exec 3<>/dev/tcp/127.0.0.1/6333; printf \"GET /readyz HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n\" >&3; IFS= read -r status <&3; [[ \"$$status\" == *\" 200 \"* ]]"
          ],
          "interval": "2s",
          "timeout": "3s",
          "retries": 20
        }
      },
      "version": "1.18.3",
      "catalog": {
        "displayName": "HiveMem Qdrant",
        "description": "Private vector datastore for HiveMem.",
        "repository": "https://github.com/qdrant/qdrant",
        "documentation": "https://qdrant.tech/documentation/",
        "license": "https://github.com/qdrant/qdrant/blob/master/LICENSE",
        "licenseSpdx": "Apache-2.0",
