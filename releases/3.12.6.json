    "magnus-postgres": {
      "image": "ghcr.io/cheftaco/hive-postgres@sha256:21a7f409c3304ae34b4d8fc38343656ab650d76ea5db2d932a4773373eaf1058",
      "kind": "datastore",
      "storageFormat": "magnus-postgres-17-runtime2",
      "service": {
        "user": "1000:1000",
        "tmpfs": [
          "/var/run/postgresql"
        ],
        "environment": {
          "PGDATA": "/data/pgdata",
          "POSTGRES_DB": "magnus",
          "POSTGRES_USER": "magnus",
          "POSTGRES_PASSWORD_FILE": "/config/password",
          "POSTGRES_INITDB_ARGS": "--data-checksums"
