          "timeout": "4s",
          "start_period": "2s",
          "retries": 30
        },
        "networks": [
          "default",
          "identity-data"
        ],
        "depends_on": {
          "oathweave-redis": {
            "condition": "service_healthy"
          }
        }
      },
      "requiresLocal": [
        "oathweave-redis"
      ],
      "version": "2.0.1",
