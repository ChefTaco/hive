    "magnus-postgres": {
      "image": "ghcr.io/cheftaco/hive-postgres@sha256:3afbd9fd4bac38bb0336462a02bd9013a61e10a1d682f75267ba3b765bee7a8d",
      "kind": "datastore",
      "storageFormat": "magnus-postgres-17",
      "service": {
        "user": "1000:1000",
        "tmpfs": [
          "/var/run/postgresql"
        ],
        "environment": {
          "PGDATA": "/data/pgdata",
          "POSTGRES_DB": "magnus",
          "POSTGRES_USER": "magnus",
          "POSTGRES_PASSWORD_FILE": "/config/password",
          "POSTGRES_INITDB_ARGS": "--data-checksums"
        },
        "networks": [
          "magnus-data"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "pg_isready",
            "-h",
            "127.0.0.1",
            "-U",
            "magnus",
            "-d",
            "magnus"
          ],
          "interval": "2s",
          "timeout": "5s",
          "retries": 40,
          "start_period": "5s"
