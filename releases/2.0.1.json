        "user": "1000:1000",
        "command": [
          "redis-server",
          "/config/redis.conf"
        ],
        "networks": [
          "identity-data"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "REDISCLI_AUTH=\"$(sed -n \"s/^requirepass //p\" /config/redis.conf)\" redis-cli --no-auth-warning ping | grep -q PONG"
          ],
          "interval": "2s",
          "timeout": "3s",
          "retries": 20
        }
      },
      "version": "8.2.10",
