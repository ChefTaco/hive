{
  "name": "hive-iam",
  "version": "0.1.0",
  "private": true,
  "description": "Hive IAM core API and Node middleware SDK",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "iam-core:build": "npm --workspace hive-iam-core run build",
    "iam-core:test": "npm --workspace hive-iam-core test",
    "iam-sdk:build": "npm --workspace @hivemagnus/hive-iam-sdk run build",
    "iam-sdk:test": "npm --workspace @hivemagnus/hive-iam-sdk test",
    "deploy:iam-core": "bash scripts/deploy-iam-core.sh"
  },
  "overrides": {
    "@hono/node-server": "2.1.5",
    "fast-uri": "3.1.9",
    "hono": "4.13.13",
    "npm": {
      "brace-expansion": "5.0.9",
      "ip-address": "10.4.0",
      "tar": "7.5.22",
      "undici": "7.29.0"
    },
    "valibot": "1.4.2",
    "mysql2": "3.24.3",
    "deepmerge-ts": "8.0.0"
  }
}
