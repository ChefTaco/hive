{
  "name": "@hivemagnus/hive-iam-sdk",
  "version": "1.0.1",
  "description": "RS256 JWT verification and RBAC middleware for services that trust Hive IAM, with a framework-agnostic verifier and Hono v4 middleware",
  "keywords": [
    "hive",
    "iam",
    "jwt",
    "rs256",
    "jose",
    "rbac",
    "authentication",
    "authorization",
    "middleware",
    "hono"
  ],
  "author": "ChefTaco",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ChefTaco/hive/tree/main/services/hive-iam/packages/iam-sdk#readme",
  "bugs": {
    "url": "https://github.com/ChefTaco/hive/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChefTaco/hive.git",
    "directory": "services/hive-iam/packages/iam-sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/middleware/hono.d.ts",
      "import": "./dist/middleware/hono.js",
      "default": "./dist/middleware/hono.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "dependencies": {
    "jose": "^6.0.0",
    "ky": "^1.7.5"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "hono": "^4.0.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
