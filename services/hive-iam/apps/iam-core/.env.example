# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4200
HOST=0.0.0.0
MAX_REQUEST_BODY_BYTES=1048576
# Only these socket peers may supply X-Forwarded-For / X-Real-IP.
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# ── Database (SQLite) ────────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/iam.db"

# ── Redis (local, namespaced) ─────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_PREFIX=hive-iam

# ── JWT (RS256) ────────────────────────────────────────────────────────────────
# Generate with: bash scripts/generate-keys.sh
JWT_PRIVATE_KEY_PATH=../certs/iam-private.pem
JWT_PUBLIC_KEY_PATH=../certs/iam-public.pem
# Comma-separated public keys retained until every token signed by them expires.
JWT_PREVIOUS_PUBLIC_KEY_PATHS=
JWT_ISSUER=iam-core
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ── Session cookie (dashboard login) ──────────────────────────────────────────
COOKIE_SECRET=change_me_32_chars_minimum_secret_here

# ── TLS (Hono HTTPS) ──────────────────────────────────────────────────────────
TLS_CERT_PATH=../certs/server.crt
TLS_KEY_PATH=../certs/server.key

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://localhost

# ── Audit log files (daily rotation) ─────────────────────────────────────────
AUDIT_LOG_DIR=./audit-logs
AUDIT_MAX_AGE_DAYS=365
AUDIT_FLUSH_INTERVAL_MS=5000
AUDIT_BATCH_SIZE=100

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# ── Agent shared secret ────────────────────────────────────────────────────────
IAM_AGENT_SECRET=change_me_agent_secret_hex_32_chars
# Required for first creation of the built-in confidential clients. Routine
# seeds preserve existing Argon2 hashes; rotate through POST /clients/:id/rotate-secret.
SEED_ADMIN_PASSWORD=change_me_admin_password_16_chars
SEED_HIVE_CLIENT_SECRET=change_me_hive_client_secret_32_chars
SEED_HIVE_ROUTER_CLIENT_SECRET=change_me_router_client_secret_32_chars
# Public base URL of the Hive control plane; used for the default redirect URIs.
SEED_HIVE_PUBLIC_URL=https://hive.example.com
SEED_HIVE_ROUTER_REDIRECT_URI=https://hive.example.com/api/auth/oidc/callback
# Optional secret for the read-only security-exporter client-credentials client.
# It receives only iam:audit:read and router:security-events:read.
SEED_SECURITY_EXPORTER_CLIENT_SECRET=
# Optional example OIDC client (example-portal). Leave the secret empty to skip it.
SEED_EXAMPLE_PORTAL_CLIENT_SECRET=
SEED_EXAMPLE_PORTAL_REDIRECT_URI=https://client.example.com/api/auth/callback/hive-iam

# ── Additional machine clients (optional) ─────────────────────────────────────
# JSON map of client ID → { audience, permissions, lifetimeSeconds, rotationOwner }.
# IAM_MACHINE_CLIENT_POLICIES={"my-api":{"audience":"my-api","permissions":["my-api:read"],"lifetimeSeconds":900,"rotationOwner":"platform-team"}}
