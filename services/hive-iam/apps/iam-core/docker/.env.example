# Copy to .env next to compose.yml and fill in the required values.
# Generate secrets with: openssl rand -hex 32

# Required
COOKIE_SECRET=
IAM_AGENT_SECRET=
REDIS_PASSWORD=
# Initial SUPER_ADMIN password, at least 16 characters (used on first start only).
SEED_ADMIN_PASSWORD=

# Optional
# IAM_PORT=4200
# Published image to run with `docker compose up -d --no-build` instead of building:
# IAM_IMAGE=ghcr.io/cheftaco/hive-iam-server:1
# SEED_ADMIN_USERNAME=admin
# Give Hive Router the same value as HIVE_ROUTER_IAM_CLIENT_SECRET (32+ characters).
# SEED_HIVE_ROUTER_CLIENT_SECRET=
# SEED_HIVE_CLIENT_SECRET=
# SEED_HIVE_PUBLIC_URL=https://hive.example.com
# CORS_ORIGIN=https://hive.example.com
# WEBAUTHN_RP_ID=hive.example.com
# WEBAUTHN_RP_ORIGIN=https://hive.example.com
