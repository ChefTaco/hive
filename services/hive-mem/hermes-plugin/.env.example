# Hermes-side configuration for the HiveMem memory provider plugin.
# Copy these into the target Hermes profile's .env or pass them to the deploy script.
HERMES_HIVEMEM_API_URL=https://hivemem.example.com
HERMES_HIVEMEM_TOKEN=<agent-jwt-from-hivemem>
# HERMES_HIVEMEM_CA_FILE=/path/to/hermes-home/plugins/hivemem/hivemem-ca.pem

# Optional overrides.
# HERMES_HIVEMEM_WORKSPACE_ID=default
# HERMES_HIVEMEM_DEFAULT_SCOPE=private
# HERMES_HIVEMEM_RECALL_SCOPE=
# HERMES_HIVEMEM_RECALL_MODE=hybrid
# HERMES_HIVEMEM_CAPTURE_TURNS=true
# HERMES_HIVEMEM_MAX_RECALL_RESULTS=5
# HERMES_HIVEMEM_CONTEXT_TOKENS=1200
# HERMES_HIVEMEM_TIMEOUT_SECONDS=5
