# Required — generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
HIVEMEM_JWT_SECRET=
# Independent server-only key for scoped renewal grants. Never copy this key to clients.
HIVEMEM_RENEWAL_SECRET=

# Qdrant connection (use "qdrant" when running inside Docker Compose)
HIVEMEM_QDRANT_HOST=localhost
HIVEMEM_QDRANT_PORT=6333
HIVEMEM_QDRANT_GRPC_PORT=6334
HIVEMEM_QDRANT_PREFER_GRPC=false
HIVEMEM_QDRANT_QUERY_CONCURRENCY=8
# Docker Compose binds Qdrant ports to 127.0.0.1 only; do not expose Qdrant directly.

# API server (internal port)
HIVEMEM_HOST=0.0.0.0
HIVEMEM_PORT=18790
HIVEMEM_DEBUG=false
HIVEMEM_LOG_LEVEL=info
HIVEMEM_WORKERS=1

# Runtime selection for deploy_server.sh. TypeScript is the only deployable runtime.
HIVEMEM_RUNTIME=typescript

# External HTTPS port (used by systemd service + deploy script)
HIVEMEM_WEB_PORT=443

# Canonical external URL (used by scripts and packaging). Override per deployment.
HIVEMEM_API_URL=https://hivemem.example.com
# Client-side TLS verification for CLI/Python SDK smoke checks. Set false only for trusted self-signed deployments.
# Optional client-side trust anchor for private PKI. TLS verification remains mandatory.
# HIVEMEM_CA_FILE=/etc/hivemem/client-ca.pem

# CORS — comma-separated allowed origins
HIVEMEM_CORS_ORIGINS=https://hivemem.example.com

# Auth
HIVEMEM_JWT_ALGORITHM=HS256
HIVEMEM_TOKEN_EXPIRE_HOURS=8760
# Existing JWT login validates agent/admin tokens signed by HIVEMEM_JWT_SECRET.
HIVEMEM_ADMIN_TOKEN=

# Dedup
HIVEMEM_DEDUP_ENABLED=true
HIVEMEM_DEDUP_SIMILARITY_THRESHOLD=0.95

# Paths
HIVEMEM_STORAGE_PATH=/var/opt/hivemem
HIVEMEM_REVOCATION_FILE=/var/opt/hivemem/revoked-tokens.json

# /metrics requires an admin JWT or this scrape token (>= 32 chars).
# HIVEMEM_METRICS_TOKEN=
# Allow unauthenticated scraping from loopback clients only.
# HIVEMEM_METRICS_ALLOW_LOOPBACK=false
HIVEMEM_USE_NFS=false
HIVEMEM_BACKUP_PATH=/var/opt/hivemem/backups
HIVEMEM_BACKUP_RETENTION_DAYS=30
HIVEMEM_NFS_BASE_PATH=/var/opt/hivemem

# Embedding model (768-dim nomic-embed-text-v1.5)
HIVEMEM_EMBEDDING_MODEL_PATH=/var/opt/hivemem/models/nomic-embed-text-v1.5.Q8_0.gguf
HIVEMEM_VECTOR_DIM=768
HIVEMEM_EMBED_ENABLED=true

# Prune
HIVEMEM_PRUNE_SOFT_DELETE_DAYS=30
HIVEMEM_PRUNE_SUPERSEDED_DAYS=30
HIVEMEM_PRUNE_EXPIRED=true
HIVEMEM_PRUNE_DECAYED=true

# Confidence decay
HIVEMEM_CONFIDENCE_DECAY_ENABLED=true
HIVEMEM_CONFIDENCE_DECAY_HALF_LIFE_DAYS=90

# Deploy — SSH credentials for deploy_server.sh
SSH_HOST=
SSH_USERNAME=
SSH_PASSWORD=
# Operator-only controls normally belong in the invoking shell, not this file:
# HIVEMEM_PRESERVE_REMOTE_ENV=true keeps the target's private env authoritative.
# HIVEMEM_REFRESH_ADMIN_TOKEN=true opts into refreshing its existing admin bearer.
# Preserved environments retain the bearer by default.
HIVEMEM_CONFIDENCE_DECAY_FLOOR=0.05

# Importance scoring
HIVEMEM_IMPORTANCE_WEIGHT=0.3

# Dashboard
HIVEMEM_DASHBOARD_ENABLED=true
HIVEMEM_DASHBOARD_PAGE_SIZE=10
HIVEMEM_DASHBOARD_FRAME_ANCESTORS='self'

# Graph memory
HIVEMEM_GRAPH_BACKEND=qdrant
HIVEMEM_GRAPH_EXTERNAL_URL=

# Async queue + server-side reasoning
HIVEMEM_QUEUE_ENABLED=true
HIVEMEM_QUEUE_WORKER_ENABLED=true
HIVEMEM_QUEUE_MAX_WORKERS=2
HIVEMEM_QUEUE_POLL_INTERVAL_SECONDS=1.0
HIVEMEM_QUEUE_STALE_LOCK_SECONDS=300
HIVEMEM_QUEUE_MAX_RETRIES=3
HIVEMEM_QUEUE_MAX_ACTIVE_PER_AGENT=0
HIVEMEM_QUEUE_MAX_ACTIVE_PER_WORKSPACE=0

# Webhooks / events
HIVEMEM_WEBHOOKS_ENABLED=true
HIVEMEM_WEBHOOK_TIMEOUT_SECONDS=10
HIVEMEM_WEBHOOK_MAX_ENDPOINTS_PER_EVENT=100
HIVEMEM_WEBHOOK_QUEUE_EMPTY_COOLDOWN_SECONDS=300
# Secure defaults: use HTTPS webhook destinations on public/global hosts.
# Set these only for trusted development or closed internal networks.
HIVEMEM_WEBHOOK_ALLOW_HTTP=false
HIVEMEM_WEBHOOK_ALLOW_PRIVATE_IPS=false
HIVEMEM_WEBHOOK_ALLOWED_HOSTS=
HIVEMEM_WEBHOOK_VERIFY_TLS=true

HIVEMEM_REASONING_ENABLED=true
HIVEMEM_REASONING_PROVIDER=local
HIVEMEM_REASONING_MODEL=local-heuristic
# Optional provider endpoint/key. Keep keys server-side only; leave blank for local-only mode.
HIVEMEM_REASONING_API_URL=
HIVEMEM_REASONING_API_KEY=
HIVEMEM_REASONING_TIMEOUT_SECONDS=60
HIVEMEM_REASONING_MAX_OUTPUT_TOKENS=2048
HIVEMEM_REASONING_BATCH_TOKENS=1000
HIVEMEM_REASONING_MAX_BATCH_MEMORIES=50
HIVEMEM_REASONING_MAX_CONCLUSIONS_PER_BATCH=20
HIVEMEM_REASONING_SUMMARY_SHORT_EVERY=5
HIVEMEM_REASONING_SUMMARY_LONG_EVERY=25
HIVEMEM_REASONING_MIN_NEW_CONCLUSIONS=3
HIVEMEM_REASONING_DREAM_COOLDOWN_SECONDS=900
HIVEMEM_REASONING_IDLE_TIMEOUT_SECONDS=60
HIVEMEM_REASONING_PEER_CARD_LIMIT=10

# Backward-compatible token alias used by some deploy/tooling paths.
HIVEMEM_MCP_TOKEN=
