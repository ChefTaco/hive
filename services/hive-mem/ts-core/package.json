{
  "name": "@hivemem/ts-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node dist/src/cli.js",
    "dev": "node --experimental-strip-types src/cli.ts",
    "test:dual-stack": "npm run build && node --test dist/tests/dual-stack-compat.test.js"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.6.0"
  },
  "bin": {
    "hivemem-ts-core": "dist/src/cli.js"
  }
}
