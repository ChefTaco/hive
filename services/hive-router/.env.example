NODE_ENV=development
LOG_LEVEL=info

API_HOST=0.0.0.0
ADMIN_HOST=127.0.0.1
API_PORT=4020
ADMIN_PORT=9443
PUBLIC_API_URL=https://localhost:4020
PUBLIC_ADMIN_URL=https://127.0.0.1:9443
HIVE_UI_PUBLIC_URL=https://127.0.0.1:9443

HIVEMEM_INTERNAL_URL=http://127.0.0.1:18790
HIVEMEM_PUBLIC_URL=https://hive.example.com
HIVEMEM_CA_CERT_PATH=
# Development-only loopback escape hatch; production startup rejects true.
HIVE_STATUS_ALLOW_INSECURE_TLS=false
# Optional server-side token for native Memory panels. Never expose this to browser code.
HIVE_ROUTER_MEMORY_PROXY_TOKEN=
HIVE_IAM_INTERNAL_URL=http://127.0.0.1:4200
HIVE_ROUTER_IAM_ISSUER=hive-iam
HIVE_ROUTER_IAM_AUDIENCE=hive-router
# Pin the private IAM certificate/CA for HTTPS verification in production.
HIVE_ROUTER_IAM_CA_CERT_PATH=
# Development-only escape hatch; accepted only for loopback and rejected in production.
HIVE_ROUTER_IAM_ALLOW_INSECURE_TLS=false
HIVE_ROUTER_IAM_JWKS_REFRESH_MS=300000
HIVE_ROUTER_IAM_JWKS_MAX_AGE_MS=900000

TLS_CERT_PATH=../certs/server.crt
TLS_KEY_PATH=../certs/server.key
REQUIRE_TLS=false

DATABASE_URL=file:./data/router.db
DATA_DIR=./data
TRACE_DIR=./data/traces

HIVE_ROUTER_SECRET=replace-with-a-long-secret-at-least-32-characters
HIVE_ROUTER_ADMIN_USERS=admin
HIVE_ROUTER_METRICS_TOKEN=

# Optional test/development helper. Production uses pamtester against Ubuntu PAM.
HIVE_ROUTER_OS_AUTH_COMMAND=

# Optional shared token for non-interactive CLI key issuance.
HIVE_ROUTER_CLI_TOKEN=

SEED_CLIENT_API_KEY=

OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PREFIX=hive_router_

DEFAULT_TRACE_RETENTION_DAYS=7
MAX_REQUEST_BODY_BYTES=67108864
MAX_ADMIN_BODY_BYTES=2097152
MAX_TRACE_BODY_BYTES=1048576
CAPTURE_BINARY_MEDIA=false
CAPTURE_REQUEST_BODIES=false
CAPTURE_RESPONSE_BODIES=false
# Dedicated scrypt hash for the cursor-based security audit exporter.
# Generate with the existing Router hashValue helper; never store the raw token here.
# Salted scrypt hash in the same salt:hash format returned by hashValue().
HIVE_ROUTER_SECURITY_EXPORT_TOKEN_HASH=
# Migration-only fallback. Leave false once the IAM exporter flow is proven.
HIVE_ROUTER_SECURITY_EXPORT_STATIC_FALLBACK_ENABLED=false
