{
  "name": "@hivemagnus/hive-router",
  "version": "1.2.2",
  "description": "Hive Router: OpenAI-compatible model gateway with routing, failover, quotas and traces, plus the admin API and the unified Hive console",
  "keywords": [
    "hive",
    "openai",
    "llm",
    "ai-gateway",
    "model-router",
    "proxy",
    "ollama",
    "vllm",
    "llama.cpp",
    "anthropic",
    "observability",
    "self-hosted"
  ],
  "homepage": "https://github.com/ChefTaco/hive/tree/main/services/hive-router#readme",
  "bugs": {
    "url": "https://github.com/ChefTaco/hive/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChefTaco/hive.git",
    "directory": "services/hive-router"
  },
  "license": "Apache-2.0",
  "author": "ChefTaco",
  "type": "module",
  "bin": {
    "hive-router": "dist/src/index.js"
  },
  "files": [
    "dist/src/**/*.js",
    "ui/dist",
    "README.md",
    "LICENSE",
    "dist/src/release/*"
  ],
  "engines": {
    "node": "^24.22.1 || ^26.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node scripts/ensure-prisma-client.mjs && tsx watch src/index.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build": "npm run build:ui && npm run build:server",
    "build:server": "npm run db:generate && npm run db:generate-bootstrap && tsc --project tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/src/index.js', 0o755)\"",
    "build:ui": "vite build --config ui/vite.config.ts",
    "start": "node dist/src/index.js",
    "cli": "node scripts/ensure-prisma-client.mjs && tsx src/cli.ts",
    "clean": "rm -rf dist ui/dist coverage tsconfig.tsbuildinfo ui/tsconfig.tsbuildinfo playwright-report test-results",
    "typecheck": "npm run db:generate && npm run contracts:check && tsc --project tsconfig.json --noEmit && tsc --project ui/tsconfig.json --noEmit",
    "test": "node scripts/ensure-prisma-client.mjs && npm run db:check-bootstrap && vitest run --passWithNoTests",
    "test:watch": "node scripts/ensure-prisma-client.mjs && vitest",
    "test:e2e": "playwright test",
    "smoke:ollama": "node scripts/ensure-prisma-client.mjs && tsx scripts/smoke-ollama.ts",
    "smoke:llamacpp": "node scripts/ensure-prisma-client.mjs && tsx scripts/smoke-llamacpp.ts",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:ensure": "node scripts/ensure-prisma-client.mjs",
    "db:push": "prisma db push --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:studio": "prisma studio --config prisma.config.ts",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "db:generate-bootstrap": "node --experimental-strip-types scripts/generate-sqlite-bootstrap.ts",
    "db:check-bootstrap": "node --experimental-strip-types scripts/generate-sqlite-bootstrap.ts --check",
    "eval:decisions": "node scripts/ensure-prisma-client.mjs && tsx scripts/eval-decisions.ts",
    "test:routing-contract": "node scripts/ensure-prisma-client.mjs && vitest run tests/routing",
    "baseline:routing": "node scripts/ensure-prisma-client.mjs && tsx scripts/baseline-routing.ts",
    "smoke:jev": "node scripts/ensure-prisma-client.mjs && tsx scripts/smoke-jev.ts",
    "contracts:generate": "tsx scripts/generate-ui-contracts.ts",
    "contracts:check": "tsx scripts/generate-ui-contracts.ts --check",
    "prebuild": "node ../../scripts/build-release-runtime.mjs services/hive-router",
    "pretypecheck": "node ../../scripts/build-release-runtime.mjs services/hive-router",
    "pretest": "node ../../scripts/build-release-runtime.mjs services/hive-router",
    "postbuild": "node ../../scripts/build-release-runtime.mjs services/hive-router --copy"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^18.0.9",
    "hono": "4.13.16",
    "jose": "^6.1.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "prisma": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@hono/node-server": "2.1.6",
