{
  "name": "hive-router",
  "version": "0.1.0",
  "description": "Hive Router — OpenAI-compatible transparent proxy, router, and observability gateway",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build": "npm run build:ui && npm run build:server",
    "build:server": "npm run db:generate-bootstrap && tsc --project tsconfig.build.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "start": "node dist/src/index.js",
    "cli": "tsx src/cli.ts",
    "clean": "rm -rf dist ui/dist coverage tsconfig.tsbuildinfo ui/tsconfig.tsbuildinfo playwright-report test-results",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project ui/tsconfig.json --noEmit",
    "test": "npm run db:check-bootstrap && vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke:ollama": "tsx scripts/smoke-ollama.ts",
    "smoke:llamacpp": "tsx scripts/smoke-llamacpp.ts",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:push": "prisma db push --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:studio": "prisma studio --config prisma.config.ts",
    "postinstall": "prisma generate --config prisma.config.ts",
    "db:generate-bootstrap": "node --experimental-strip-types scripts/generate-sqlite-bootstrap.ts",
    "db:check-bootstrap": "node --experimental-strip-types scripts/generate-sqlite-bootstrap.ts --check",
    "eval:decisions": "tsx scripts/eval-decisions.ts",
    "test:routing-contract": "vitest run tests/routing",
    "baseline:routing": "tsx scripts/baseline-routing.ts",
    "smoke:jev": "tsx scripts/smoke-jev.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "hono": "4.13.13",
    "jose": "^6.2.13",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "@hivemem/contracts": "file:../../packages/hive-contracts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "prisma": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@hono/node-server": "2.1.5",
    "deepmerge-ts": "8.0.0",
    "fast-uri": "3.1.7",
    "hono": "4.13.13",
    "valibot": "1.4.2",
    "mysql2": "3.24.3"
  }
}
