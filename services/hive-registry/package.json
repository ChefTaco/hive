    "start": "node --disable-warning=ExperimentalWarning dist/server.js"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "6.0.3"
  }
