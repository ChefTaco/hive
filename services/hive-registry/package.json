{
  "name": "hive-registry",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Hive Registry: the per-installation install catalog and lookup API. Not the HiveSkills skills registry.",
  "license": "Apache-2.0",
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
