  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "check": "npm run build",
    "start": "node dist/server.js",
    "dev": "npm run build && node --watch dist/server.js",
    "test": "npm run build && node --test dist/*.test.js scripts/*.test.mjs",
    "seed": "npm run build && node dist/seed.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm test",
    "prebuild": "node ../../scripts/build-release-runtime.mjs services/hive-skills",
    "pretypecheck": "node ../../scripts/build-release-runtime.mjs services/hive-skills",
    "pretest": "node ../../scripts/build-release-runtime.mjs services/hive-skills",
    "postbuild": "node ../../scripts/build-release-runtime.mjs services/hive-skills --copy"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "description": "Hive Skills: HTTPS registry for digest-verified Hermes skills, OS-authenticated administration and agent distribution",
