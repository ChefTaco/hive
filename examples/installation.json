{
  "schema": 1,
  "installation": "example-suite",
  "release": "0.1.0",
  "profile": "core",
  "origin": "https://hive.example.com",
  "hosts": {
    "control": {"target": "local", "directory": "/opt/hive"}
  },
  "components": {
    "oathweave": {"host": "control", "envFile": "/opt/hive/config/oathweave.env", "configDirectory": "/opt/hive/config/oathweave"},
    "emberpath": {"host": "control", "envFile": "/opt/hive/config/emberpath.env", "configDirectory": "/opt/hive/config/emberpath"},
    "hivemem": {"host": "control", "envFile": "/opt/hive/config/hivemem.env"},
    "hiveskills": {"host": "control", "envFile": "/opt/hive/config/hiveskills.env", "configDirectory": "/opt/hive/config/hiveskills"},
    "hivexui": {"host": "control"}
  },
  "agents": [],
  "inference": []
}
