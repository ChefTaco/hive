{
  "schema": 1,
  "installation": "example-suite",
  "release": "0.1.0",
  "profile": "core",
  "origin": "https://hive.example.com",
  "hosts": {
    "control": {
      "target": "local",
      "directory": "/opt/hive"
    }
  },
  "components": {
    "oathweave": {
      "host": "control",
      "envFile": "/opt/hive/config/oathweave.env",
      "configDirectory": "/opt/hive/config/oathweave"
    },
    "emberpath": {
      "host": "control",
      "envFile": "/opt/hive/config/emberpath.env",
      "configDirectory": "/opt/hive/config/emberpath"
    },
    "hivemem": {
      "host": "control",
      "envFile": "/opt/hive/config/hivemem.env",
      "configDirectory": "/opt/hive/config/hivemem"
    },
    "hiveskills": {
      "host": "control",
      "envFile": "/opt/hive/config/hiveskills.env",
      "configDirectory": "/opt/hive/config/hiveskills"
    },
    "hivexui": {
      "host": "control"
    },
    "ingress": {
      "host": "control",
      "envFile": "/opt/hive/config/ingress.env",
      "configDirectory": "/opt/hive/config/ingress"
    },
    "oathweave-redis": {
      "host": "control",
      "configDirectory": "/opt/hive/config/oathweave-redis"
    },
    "hivemem-qdrant": {
      "host": "control",
      "configDirectory": "/opt/hive/config/hivemem-qdrant"
    }
  },
  "agents": [],
  "inference": [],
  "console": {
    "host": "control",
    "bindAddress": "127.0.0.1",
    "httpsPort": 8443,
    "runtimeFile": "/opt/hive/config/runtime.json"
  },
  "bootstrap": {
    "adminUsername": "admin",
    "adminEmail": "admin@example.com",
    "certificateFile": "/secure/hive/console.crt",
    "privateKeyFile": "/secure/hive/console.key"
  }
}
