{
  "name": "@hivemem/contracts",
  "version": "1.0.0",
  "description": "Typed contracts, Zod schemas, and service clients for the Hive IAM, HiveMem, and Router APIs.",
  "keywords": [
    "hive",
    "hivemem",
    "contracts",
    "zod",
    "typescript",
    "iam",
    "memory",
    "api-client"
  ],
  "author": "ChefTaco",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChefTaco/hive.git",
    "directory": "packages/hive-contracts"
  },
  "homepage": "https://github.com/ChefTaco/hive/tree/main/packages/hive-contracts#readme",
  "bugs": {
    "url": "https://github.com/ChefTaco/hive/issues"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./ui-api": {
      "types": "./dist/src/ui-api.generated.d.ts",
      "import": "./dist/src/ui-api.generated.js"
    },
    "./service-health": {
      "types": "./dist/src/service-health.d.ts",
      "import": "./dist/src/service-health.js"
    },
    "./service-clients": {
      "types": "./dist/src/service-clients.d.ts",
      "import": "./dist/src/service-clients.js"
    },
    "./service-manifest": {
      "types": "./dist/src/service-manifest.d.ts",
      "import": "./dist/src/service-manifest.js"
    },
    "./memory-operations": {
      "types": "./dist/src/memory-operations.d.ts",
      "import": "./dist/src/memory-operations.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:ui": "tsx scripts/generate-ui-contracts.ts",
    "check:generated": "tsx scripts/generate-ui-contracts.ts --check",
    "typecheck": "npm run check:generated && tsc --noEmit",
    "build": "tsc",
    "test": "npm run check:generated && npm run build && node --test dist/tests/**/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.6.0"
  }
}
